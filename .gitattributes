# Auto detect text files and perform LF normalization
* text=auto

# SQL files
*.sql text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Documentation
*.md text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
